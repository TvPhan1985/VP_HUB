{
  "info": {
    "proto": "vph", "pv": 1, "model": "demoall", "name": "DEMO-ALL", "fw": "0.9.0", "hw": "demo",
    "hdr": ["pv", "run", "fault", "warn"], "caps": ["time"], "icon": "sensor"
  },
  "screens": [
    {"id": "live", "l": "Data Types", "save": "live", "f": [
      {"id": "pv", "l": "Kiln temperature", "t": "num", "u": "°C", "dp": 1, "ro": 1, "w": "big,trend"},
      {"id": "sv", "l": "Setpoint", "t": "num", "u": "°C", "min": 0, "max": 1200, "st": 5, "dp": 0},
      {"id": "press", "l": "Pressure", "t": "num", "u": "bar", "dp": 2, "ro": 1, "min": 0, "max": 10, "w": "gauge"},
      {"id": "limit", "l": "Power limit", "t": "num", "u": "%", "min": 10, "max": 100, "st": 10, "nul": 1},
      {"id": "run", "l": "Running", "t": "bool", "c": "Start the device?"},
      {"id": "door", "l": "Door closed", "t": "bool", "ro": 1, "w": "led"},
      {"id": "fault", "l": "Fault", "t": "bool", "ro": 1, "w": "led,warn"},
      {"id": "state", "l": "Status", "t": "text"},
      {"id": "note", "l": "Long note", "t": "text"},
      {"id": "_name", "l": "Device name", "t": "str", "max": 20},
      {"id": "mode", "l": "Mode", "t": "enum", "opt": [["off", "Off"], ["manual", "Manual"], ["auto", "Auto"]]},
      {"id": "baud", "l": "Baud rate", "t": "enum", "opt": [[1200, "1200"], [2400, "2400"], [4800, "4800"], [9600, "9600"], [19200, "19200"], [115200, "115200"]], "adv": 1},
      {"id": "fan", "l": "Fan (Manual mode only)", "t": "bool", "en": "mode==manual"},
      {"id": "boost", "l": "Boost (hidden when Off)", "t": "act", "if": "mode!=off&&run==true"},
      {"id": "start", "l": "Start time", "t": "time"},
      {"id": "until", "l": "Run until", "t": "date", "nul": 1},
      {"id": "wdays", "l": "Run days", "t": "days"},
      {"id": "warn", "l": "Warnings", "t": "flags", "opt": ["Overtemperature", "Sensor lost", "Door open"]},
      {"id": "reset", "l": "Clear warnings", "t": "act", "c": "Clear all warnings?", "if": "warn!=0"},
      {"id": "alien", "l": "Unknown type", "t": "xyz"},
      {"id": "odd", "l": "Unknown hint", "t": "num", "u": "V", "ro": 1, "w": "hologram"}
    ]},
    {"id": "groups", "l": "Groups & Repeat", "save": "batch", "f": [
      {"id": "kp", "l": "Kp", "t": "num", "min": 0, "max": 100, "st": 0.1, "g": "PID", "adv": 1},
      {"id": "ki", "l": "Ki", "t": "num", "min": 0, "max": 10, "st": 0.01, "g": "PID", "adv": 1},
      {"id": "kd", "l": "Kd", "t": "num", "min": 0, "max": 500, "st": 1, "g": "PID", "adv": 1},
      {"id": "lo", "l": "Low threshold", "t": "num", "u": "°C", "min": -40, "max": 120, "st": 0.5, "g": "Alarm"},
      {"id": "hi", "l": "High threshold", "t": "num", "u": "°C", "min": -40, "max": 120, "st": 0.5, "g": "Alarm"},
      {"id": "steps", "l": "Step count", "t": "num", "min": 1, "max": 4, "st": 1}
    ],
    "rep": {"n": 4, "pfx": "p", "l": "Step", "cnt": "steps", "f": [
      {"id": "t", "l": "Target temperature", "t": "num", "u": "°C", "min": 0, "max": 1200, "st": 10},
      {"id": "r", "l": "Ramp time", "t": "num", "u": "min", "min": 0, "max": 600, "st": 5},
      {"id": "hold", "l": "Hold", "t": "bool"},
      {"id": "s", "l": "Hold time", "t": "num", "u": "min", "min": 0, "max": 600, "st": 5, "if": "hold==true"}
    ]}},
    {"id": "hints", "l": "New Hints", "ic": "dashboard", "save": "live", "f": [
      {"id": "n_t", "l": "Temperature", "t": "num", "u": "°C", "dp": 1, "ro": 1, "w": "tile,trend", "ic": "temp"},
      {"id": "n_h", "l": "Humidity", "t": "num", "u": "%", "dp": 1, "ro": 1, "w": "tile", "ic": "hum"},
      {"id": "n_st", "l": "Stage", "t": "text", "w": "tile", "ic": "fire"},
      {"id": "n_ec", "l": "EC", "t": "num", "ro": 1, "w": "mini"},
      {"id": "n_sal", "l": "Salinity", "t": "num", "ro": 1, "w": "mini"},
      {"id": "n_tds", "l": "TDS", "t": "num", "ro": 1, "w": "mini"},
      {"id": "n_sok", "l": "Sensor disconnected", "t": "bool", "ro": 1, "w": "note", "if": "n_sok==false"},
      {"id": "n_out", "l": "Pump", "t": "bool", "w": "hero,btns", "ic": "pump", "sub": "n_mode", "en": "n_mode==manual",
       "d": "Manual switching is available in Manual mode only"},
      {"id": "n_mode", "l": "Pump mode", "t": "enum", "w": "seg", "opt": [["manual", "Manual", "hand"], ["auto", "Auto", "auto"]]},
      {"id": "n_burn", "l": "Burner", "t": "bool", "w": "hero,warn", "ic": "fire", "opt": ["Stopped", "Firing"], "sub": "n_t"},
      {"id": "n_al", "l": "Pump alarm", "t": "flags", "w": "alarm", "g": "nal", "opt": ["Dry run", "Overcurrent", "Phase loss"]},
      {"id": "n_sil", "l": "Silence", "t": "act", "ic": "mute", "g": "nal", "if": "n_al!=0"},
      {"id": "n_lock", "l": "Safety lock", "t": "bool", "ro": 1, "w": "alarm", "g": "nlk"},
      {"id": "n_why", "l": "Reason", "t": "text", "g": "nlk", "if": "n_lock==true"},
      {"id": "n_fan", "l": "Fan", "t": "bool", "w": "btns", "ic": "fan", "g": "Other"},
      {"id": "n_up", "l": "Uptime", "t": "num", "u": "s", "ro": 1, "w": "dur", "ic": "timer", "g": "Other"},
      {"id": "n_icx", "l": "Unknown icon", "t": "text", "ic": "khong_co_icon_nay", "d": "An unknown icon name shows no icon", "g": "Other"}
    ]},
    {"id": "legacy", "title": "Long Keys", "fields": [
      {"id": "old_pv", "label": "Temperature", "type": "float", "unit": "°C", "readonly": true},
      {"id": "old_sv", "label": "Setpoint", "type": "float", "unit": "°C", "min": 0, "max": 1200, "step": 1},
      {"id": "old_cnt", "label": "Counter", "type": "int", "readonly": true}
    ],
    "repeat": {"count": 2, "prefix": "step", "fields": [
      {"id": "t", "label": "Target", "type": "float", "unit": "°C", "min": 0, "max": 1200, "step": 5}
    ]}},
    {"l": "Broken screen (missing id)", "f": [{"id": "x", "t": "num"}]}
  ],
