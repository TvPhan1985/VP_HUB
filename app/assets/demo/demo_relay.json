{
  "info": {
    "proto": "vph", "pv": 1, "model": "demorelay", "name": "DEMO-RELAY", "fw": "1.1.0", "hw": "demo",
    "hdr": ["t", "h", "out", "mode", "alarm"], "caps": ["time"], "icon": "relay", "dom": "agri"
  },
  "screens": [
    {"id": "overview", "l": "Overview", "ic": "dashboard", "save": "live", "f": [
      {"id": "t", "l": "Temperature", "t": "num", "u": "°C", "dp": 1, "ro": 1, "w": "tile,trend", "ic": "temp"},
      {"id": "h", "l": "Humidity", "t": "num", "u": "%", "dp": 1, "ro": 1, "w": "tile", "ic": "hum"},
      {"id": "ec", "l": "EC", "t": "num", "ro": 1, "w": "mini"},
      {"id": "sal", "l": "Salinity", "t": "num", "ro": 1, "w": "mini"},
      {"id": "tds", "l": "TDS", "t": "num", "ro": 1, "w": "mini"},
      {"id": "sok", "l": "Sensor has no data or is disconnected", "t": "bool", "ro": 1, "w": "note", "if": "sok==false"},
      {"id": "out", "l": "Relay", "t": "bool", "w": "hero,btns", "ic": "power", "sub": "mode", "en": "mode==manual",
       "d": "Manual switching is available in Manual mode only"},
      {"id": "mode", "l": "Mode", "t": "enum", "w": "seg", "opt": [["manual", "Manual", "hand"], ["auto", "Auto", "auto"]]},
      {"id": "alarm", "l": "Alarm", "t": "flags", "w": "alarm", "g": "al",
       "opt": ["Sensor lost", "Clock not set", "Temperature out of range", "Humidity out of range"]},
      {"id": "silence", "l": "Silence", "t": "act", "ic": "mute", "g": "al", "if": "alarm!=0&&muted!=true"},
      {"id": "muted", "l": "Buzzer silenced", "t": "bool", "ro": 1, "w": "led", "ic": "mute", "g": "al", "if": "alarm!=0&&muted==true"},
      {"id": "time", "l": "Device time", "t": "text", "ic": "clock", "g": "Status"},
      {"id": "tok", "l": "Device clock is not set", "t": "bool", "ro": 1, "w": "note", "g": "Status", "if": "tok==false"},
      {"id": "up", "l": "Uptime", "t": "num", "u": "s", "dp": 0, "ro": 1, "w": "dur", "ic": "timer", "g": "Status"}
    ]},
    {"id": "auto", "l": "Schedule", "ic": "schedule", "save": "batch", "f": [
      {"id": "src", "l": "Auto source", "t": "enum", "w": "seg",
       "d": "Combined: on only while inside a time slot AND the sensor calls for it.",
       "opt": [["schedule", "Schedule"], ["sensor", "Sensor"], ["both", "Combined"]]},
      {"id": "on_at", "l": "On when humidity below", "t": "num", "u": "%", "min": 0, "max": 100, "st": 1, "if": "src!=schedule", "g": "Sensor thresholds"},
      {"id": "off_at", "l": "Off when humidity above", "t": "num", "u": "%", "min": 0, "max": 100, "st": 1, "if": "src!=schedule", "g": "Sensor thresholds"}
    ],
    "rep": {"n": 3, "pfx": "s", "l": "Slot", "f": [
      {"id": "en", "l": "Enabled", "t": "bool"},
      {"id": "days", "l": "Days", "t": "days", "en": "en==true"},
      {"id": "on", "l": "On time", "t": "time", "en": "en==true"},
      {"id": "off", "l": "Off time", "t": "time", "en": "en==true", "d": "Off time earlier than on time = overnight"}
    ]}},
    {"id": "adv", "l": "Advanced", "ic": "tune", "nav": "menu", "save": "batch", "f": [
      {"id": "al_en", "l": "Temperature / humidity alarm", "t": "bool", "g": "Alarm thresholds"},
      {"id": "al_lo", "l": "Low temperature", "t": "num", "u": "°C", "min": -20, "max": 80, "st": 1, "g": "Alarm thresholds"},
      {"id": "al_hi", "l": "High temperature", "t": "num", "u": "°C", "min": -20, "max": 80, "st": 1, "g": "Alarm thresholds"}
    ]},
    {"id": "device", "l": "Device", "ic": "device", "nav": "menu", "save": "live", "f": [
      {"id": "_name", "l": "Device name", "t": "str", "max": 20, "ic": "device"},
      {"id": "fw", "l": "Firmware", "t": "text", "ic": "chip"},
      {"id": "_reboot", "l": "Restart device", "t": "act", "ic": "reset", "c": "Restart the device?"}
    ]}
  ],
  "values": {
    "t": 28.4, "h": 72.5, "ec": 120, "sal": 40, "tds": 60, "sok": true, "tok": false,
    "mode": "manual", "out": true, "alarm": 2, "muted": false, "time": "2026-10-07 09:15", "up": 7512,
    "src": "both", "on_at": 70, "off_at": 80,
    "al_en": true, "al_lo": 10, "al_hi": 40, "_name": "DEMO-RELAY", "fw": "1.1.0",
    "s1_en": true, "s1_days": 127, "s1_on": "08:00", "s1_off": "17:00",
    "s2_en": false, "s2_days": 31, "s2_on": "19:00", "s2_off": "21:30",
    "s3_en": false, "s3_days": 96, "s3_on": "06:00", "s3_off": "07:00"
  }
}
