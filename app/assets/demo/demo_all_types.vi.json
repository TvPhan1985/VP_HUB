      {"id": "n_al", "l": "Báo động bơm", "t": "flags", "w": "alarm", "g": "nal", "opt": ["Cạn nước", "Quá dòng", "Mất pha"]},
      {"id": "n_sil", "l": "Tắt chuông", "t": "act", "ic": "mute", "g": "nal", "if": "n_al!=0"},
