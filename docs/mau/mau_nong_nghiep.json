      {"id": "silence", "l": "Silence buzzer", "t": "act", "ic": "mute", "g": "al", "if": "alarm!=0"},
      {"id": "time", "l": "Device time", "t": "text", "ic": "clock", "g": "Status"},
      {"id": "up", "l": "Uptime", "t": "num", "u": "s", "dp": 0, "ro": 1, "w": "dur", "ic": "timer", "g": "Status"}
    ]},
    {"id": "sched", "l": "Irrigation", "ic": "schedule", "save": "batch", "f": [
      {"id": "on_at", "l": "Start below", "t": "num", "u": "%", "min": 0, "max": 100, "st": 1, "g": "Soil moisture thresholds"},
      {"id": "off_at", "l": "Stop above", "t": "num", "u": "%", "min": 0, "max": 100, "st": 1, "g": "Soil moisture thresholds",
       "d": "Between the two thresholds the pump keeps its current state."}
    ],
    "rep": {"n": 3, "pfx": "s", "l": "Slot", "f": [
      {"id": "en", "l": "Enabled", "t": "bool"},
      {"id": "days", "l": "Days", "t": "days", "en": "en==true"},
      {"id": "on", "l": "Start time", "t": "time", "en": "en==true"},
      {"id": "dur", "l": "Duration", "t": "num", "u": "min", "min": 1, "max": 240, "st": 1, "en": "en==true"}
    ]}},
    {"id": "setup", "l": "Alarm settings", "ic": "alarm", "nav": "menu", "save": "batch", "f": [
      {"id": "al_en", "l": "Tank-empty alarm", "t": "bool", "g": "Alarm"},
      {"id": "al_lvl", "l": "Tank low level", "t": "num", "u": "%", "min": 0, "max": 50, "st": 1, "g": "Alarm", "en": "al_en==true"},
      {"id": "soil_off", "l": "Soil sensor offset", "t": "num", "u": "%", "min": -10, "max": 10, "st": 0.5, "dp": 1, "adv": 1, "g": "Calibration"}
